<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="14dp"
    android:background="@drawable/edittext_redondo2"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvGrupoNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Física 10A"
        android:textColor="@color/colorPrimario"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGrupoProfesor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Profesor Juan"
        android:textColor="#64748B"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvGrupoInstitucion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Institución Educativa"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvGrupoResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="4 actividades · 2 pendientes"
        android:textColor="#0A7DB6"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPendientes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pendientes: 2"
            android:textColor="#475569"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvEntregadas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Entregadas: 1"
            android:textColor="#475569"
            android:textSize="13sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnVerGrupo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/colorPrimario"
        android:text="Ver actividades"
        android:textAllCaps="false"
        android:textColor="@color/white" />

</LinearLayout>