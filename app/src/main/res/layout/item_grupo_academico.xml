<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="18dp"
    android:layout_marginTop="18dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="5dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="-22dp"
            android:layout_marginBottom="18dp"
            android:background="@color/colorPrimario"
            android:gravity="center_vertical"
            android:paddingHorizontal="22dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_logo_fisikapp"
                app:tint="@android:color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Grupo académico"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvGrupoNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Física 10A"
            android:textColor="@color/colorPrimario"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGrupoProfesor"
            android:drawableStart="@android:drawable/ic_menu_myplaces"
            android:drawablePadding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Profesor Juan"
            android:textColor="#64748B"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvGrupoInstitucion"
            android:drawableStart="@android:drawable/ic_menu_info_details"
            android:drawablePadding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Institución Educativa"
            android:textColor="#64748B"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvGrupoResumen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="4 actividades • 2 pendientes"
            android:textColor="@color/colorSecundario"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/tvPendientes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Pendientes: 2"
                android:textColor="#475569"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvEntregadas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Entregadas: 1"
                android:textColor="#475569"
                android:textSize="15sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnVerGrupo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/colorPrimario"
            android:text="Ver actividades"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:letterSpacing="0.02"
            android:textStyle="bold"
            app:cornerRadius="28dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>

