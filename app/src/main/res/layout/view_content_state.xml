<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutContentState"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/progressContentState"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvContentStateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Cargando..."
        android:textColor="#001B6B"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvContentStateMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Por favor espera."
        android:textColor="#64748B"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnContentStateRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:backgroundTint="#001B6B"
        android:text="Reintentar"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:visibility="gone" />

</LinearLayout>