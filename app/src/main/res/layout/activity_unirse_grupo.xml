<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="28dp"
            android:paddingBottom="16dp"
            android:paddingHorizontal="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unirme a un grupo"
                android:textColor="@color/colorScreenCompany"
                android:textSize="28sp"
                android:fontFamily="sans-serif-condensed-medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Escanea el código QR o ingresa manualmente el código entregado por tu instructor."
                android:textColor="#64748B"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.2" />
        </LinearLayout>

        <!-- SECCIÓN INFERIOR AZUL OSCURO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorScreenCompany"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingBottom="28dp">

            <!-- CardView con el QR -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <FrameLayout
                    android:id="@+id/qrContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:foreground="@drawable/bg_border_advertencia_optional"
                    android:padding="2dp">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/previewQr"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <com.marcos.fisikappmovil.ui.AccesoAlSistema.QrGuideOverlayView
                        android:id="@+id/qrGuideOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <!-- Botón QR Amarillo -->
                    <LinearLayout
                        android:id="@+id/btnQrLarge"
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_qr_button"
                        android:backgroundTint="@color/colorAdvertencia"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:elevation="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="QR"
                            android:textColor="@color/black"
                            android:textSize="38sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SCAN"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:letterSpacing="0.1"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvQrStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_margin="12dp"
                        android:background="@color/colorScreenCompany"
                        android:padding="12dp"
                        android:text="Toca QR Scan para activar la cámara"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Divisor "O" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#475569" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="O INGRESA EL CÓDIGO"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginHorizontal="16dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#475569" />
            </LinearLayout>

            <!-- Input Código -->
            <EditText
                android:id="@+id/edtCodigoGrupo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_redondo2"
                android:hint="Código del grupo"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:textColorHint="#94A3B8"
                android:drawableStart="@android:drawable/ic_lock_lock"
                android:drawablePadding="12dp"
                android:drawableTint="#94A3B8" />

            <!-- Botón Unirse -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnirseGrupo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/colorAdvertencia"
                android:text="Ingresar código"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:elevation="4dp" />

            <!-- Estado -->
            <TextView
                android:id="@+id/tvEstadoUnion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text=""
                android:textAlignment="center"
                android:textColor="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>