<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorFondoPrincipal"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".ui.Laboratorio.GrupoLaboratoriosActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="#001B6B"
            android:padding="24dp">

            <ImageView
                android:id="@+id/btnBackGrupoLabs"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="start"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/outline_arrow_circle_left_24"
                app:tint="#DCFBFF" />

            <ImageView
                android:layout_width="96dp"
                android:layout_height="70dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/vector_main_logo" />


            <TextView
                android:id="@+id/tvNombreUsuarioBarraGrupoLabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#DCFBFF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="ESTUDIANTE" />

            <TextView
                android:id="@+id/tvTituloGrupoLabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Grupo 10A"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtituloGrupoLabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Laboratorios asignados"
                android:textColor="#B4C6EF"
                android:textSize="14sp"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-30dp"
            android:layout_marginBottom="-20dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:paddingBottom="48dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/tvResumenGrupoLabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selecciona un laboratorio asignado para continuar."
                    android:textColor="#64748B"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvEstadoVacioGrupoLabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="24dp"
                    android:text="Cargando laboratorios..."
                    android:textAlignment="center"
                    android:textColor="#64748B"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <include
                    android:id="@+id/stateDashboardGrupos"
                    layout="@layout/view_content_state" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLaboratoriosAsignados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>