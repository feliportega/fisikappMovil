<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    tools:context=".ui.MonitorDeAprendizajeEstudiante.PracticaExperimental">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimario"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/white_circle"
                android:contentDescription="Regresar"
                android:padding="8dp"
                android:src="@drawable/iconoretroceder"
                app:tint="@color/colorPrimario" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPracticaTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Práctica experimental"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPracticaSubtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Sigue las instrucciones y registra tus resultados"
                    android:textColor="#D1D5DB"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- CONTENEDOR DINÁMICO: INFORMACIÓN DEL EJERCICIO -->
            <LinearLayout
                android:id="@+id/layoutPracticeInfoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- CONTENEDOR DINÁMICO: PROCEDIMIENTO -->
            <LinearLayout
                android:id="@+id/layoutProcedureContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />

            <!-- CONTENEDOR DINÁMICO: CAMPOS ESPERADOS -->
            <LinearLayout
                android:id="@+id/layoutExpectedInputsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />

            <!-- EVIDENCIAS -->
            <TextView
                android:id="@+id/tvTituloEvidencias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Evidencias"
                android:textColor="@color/colorPrimario"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescripcionEvidencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Adjunta imágenes o documentos que respalden tu práctica experimental."
                android:textColor="#64748B"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/layoutAgregarEvidencia"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/input_recuperrar"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Añadir evidencia"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="#FACC15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="+ Agregar evidencia"
                    android:textColor="@color/colorPrimario"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTiposEvidencia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Imagen o documento"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvEstadoEvidencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Aún no has agregado evidencias."
                android:textColor="#64748B"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/layoutEvidenciasContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <!-- BOTÓN FINAL -->
            <Button
                android:id="@+id/btnContinuar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#FACC15"
                android:text="Guardar y continuar"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimario"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>