<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="14dp"
    android:background="@drawable/edittext_redondo2"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvLabTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tiro parabólico"
        android:textColor="@color/colorPrimario"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLabKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="PARABOLIC-001"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvLabEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Asignación: ABIERTO · Entrega: PENDIENTE"
        android:textColor="#0A7DB6"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLabIntentos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Intentos: 0/4"
        android:textColor="#475569"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvLabFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Fecha límite: 2026-06-30"
        android:textColor="#475569"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvLabCalificacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Calificación: Pendiente"
        android:textColor="#64748B"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnVerLaboratorio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/colorPrimario"
        android:text="Ver laboratorio"
        android:textAllCaps="false"
        android:textColor="@color/white" />

</LinearLayout>