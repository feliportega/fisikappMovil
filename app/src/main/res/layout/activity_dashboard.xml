<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF5FB"
    tools:context=".ui.AccesoAlSistema.Dashboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <View
            android:layout_width="match_parent"
            android:layout_height="25dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_logo_fisikapp"
                    app:tint="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Fisikapp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimario"
                    android:textSize="22sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvNombreUsuarioBarra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PEPITO"
                    android:textStyle="normal"
                    android:textColor="#64748B"
                    android:textSize="13sp"/>

                <ImageView
                    android:id="@+id/imgcerrar_sesion"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_circulo_gris"
                    android:padding="16dp"
                    android:src="@drawable/iconousuario"/>


            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txtLaboratorio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            android:text="¡Bienvenido de nuevo!"
            android:textColor="@color/colorPrimario"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtituloDashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            android:text="Selecciona uno de estos grupos para comenzar"
            android:textColor="#64748B"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvEstadoVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="24dp"
            android:text="Cargando tus grupos..."
            android:textAlignment="center"
            android:textColor="#64748B"
            android:textSize="15sp"
            android:visibility="gone" />

        <include
            android:id="@+id/stateDashboardGrupos"
            layout="@layout/view_content_state" />

        <!-- RecyclerView CORRECTO -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>


        <Button
            android:id="@+id/btemp"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="#FDDF64"
            android:text="Unirme a un grupo"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimario"
            android:textStyle="bold"
            android:textSize="17sp"
            app:cornerRadius="28dp"/>
    </LinearLayout>

</ScrollView>