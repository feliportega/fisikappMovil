<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF5FB"
    tools:context=".ui.AccesoAlSistema.Dashboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <View
            android:layout_width="match_parent"
            android:layout_height="25dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_logo_fisikapp"
                    app:tint="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Fisikapp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimario"
                    android:textSize="22sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvNombreUsuarioBarra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PEPITO"
                    android:textStyle="bold"
                    android:textColor="@color/colorSecundario"
                    android:textSize="14sp"/>

                <ImageView
                    android:id="@+id/imgcerrar_sesion"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_circulo_gris"
                    android:padding="8dp"
                    android:src="@drawable/iconousuario"/>


            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Buscador -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#94A3B8"/>

                <EditText
                    android:id="@+id/edtBuscar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Buscar grupos o actividades..."
                    android:inputType="text"
                    android:textColor="@color/colorPrimario"
                    android:textColorHint="#94A3B8"
                    android:textSize="16sp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <TextView
            android:id="@+id/txtLaboratorio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_gravity="center"
            android:text="¡Bienvenido de nuevo!"
            android:textColor="@color/colorPrimario"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtituloDashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="center"
            android:text="Estos son tus grupos y actividades asignadas"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/tvEstadoVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="24dp"
            android:text="Cargando tus grupos..."
            android:textAlignment="center"
            android:textColor="#64748B"
            android:textSize="15sp"
            android:visibility="gone" />

        <include
            android:id="@+id/stateDashboardGrupos"
            layout="@layout/view_content_state" />

        <!-- RecyclerView CORRECTO -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>


        <Button
            android:id="@+id/btemp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:backgroundTint="#FDDF64"
            android:padding="16dp"
            android:text="Unirme a un grupo"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            android:layout_marginHorizontal="24dp"/>
    </LinearLayout>

</ScrollView>