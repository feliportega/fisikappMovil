<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimario"
    tools:context=".ui.AccesoAlSistema.Dashboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <ImageView
            android:layout_width="140dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:layout_marginTop="28dp"
            android:src="@drawable/vector_main_logo"
            app:tint="@null"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="22dp">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/vector_main_logo"
                    app:tint="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Fisikapp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimario"
                    android:letterSpacing="0.02"
                    android:textSize="22sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvNombreUsuarioBarra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PEPITO"
                    android:textStyle="normal"
                    android:textColor="#64748B"
                    android:textSize="15sp"/>

                <ImageView
                    android:id="@+id/imgcerrar_sesion"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_circulo_gris"
                    android:padding="16dp"
                    android:src="@drawable/iconousuario"/>


            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txtLaboratorio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="24dp"
            android:text="¡Bienvenido de nuevo!"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtituloDashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:text="Selecciona uno de tus grupos para comenzar"
            android:textColor="#B4C6EF"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvEstadoVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="24dp"
            android:text="Cargando tus grupos..."
            android:textAlignment="center"
            android:textColor="#64748B"
            android:textSize="15sp"
            android:visibility="gone" />

        <include
            android:id="@+id/stateDashboardGrupos"
            layout="@layout/view_content_state" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="14dp"
            android:text="Tus grupos"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>


        <!-- RecyclerView CORRECTO -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

        <Button
            android:id="@+id/btemp"
            android:layout_width="300dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="40dp"
            android:backgroundTint="@color/colorAdvertencia"
            android:text="Unirme a un grupo"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimario"
            android:textStyle="bold"
            android:textSize="17sp"
            android:elevation="3dp"
            app:cornerRadius="28dp"/>
    </LinearLayout>

</ScrollView>