<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimario"
    android:orientation="vertical"
    tools:context=".ui.Autenticacion.Register">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/vector_main_logo"
            android:contentDescription="Logo Fisikapp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Registro - Crear cuenta"
            android:textColor="#E2E8F0"
            android:textSize="20sp"
            android:textAlignment="center" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.2"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        app:cardBackgroundColor="#FFFFFFFF"
        app:cardCornerRadius="32dp"
        app:cardElevation="6dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre completo"
                    android:textColor="#475569"
                    android:textStyle="bold"
                    android:textSize="15sp" />
                <EditText
                    android:id="@+id/edtNombreCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edittext_moderno"
                    android:backgroundTint="@color/white"
                    android:drawableStart="@drawable/iconousuario"
                    android:drawablePadding="14dp"
                    android:hint="nombre de ejemplo"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Correo electrónico"
                    android:textColor="#475569"
                    android:textStyle="bold"
                    android:textSize="15sp" />
                <EditText
                    android:id="@+id/edtCorreoRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edittext_moderno"
                    android:backgroundTint="@color/white"
                    android:drawableStart="@drawable/ci_email"
                    android:drawablePadding="14dp"
                    android:hint="ejemplo@soy.sena.com"
                    android:inputType="textEmailAddress"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Identificación"
                    android:textColor="#475569"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/edtIdentificacionRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edittext_moderno"
                    android:backgroundTint="@color/white"
                    android:drawableStart="@drawable/iconousuario"
                    android:drawablePadding="14dp"
                    android:hint="100003"
                    android:inputType="number"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Contraseña"
                    android:textColor="#475569"
                    android:textStyle="bold"
                    android:textSize="15sp" />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp">
                    <EditText
                        android:id="@+id/edtPasswordRegistro"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/edittext_moderno"
                        android:backgroundTint="@color/white"
                        android:drawableStart="@drawable/baseline_lock_24"
                        android:drawablePadding="14dp"
                        android:hint="........."
                        android:inputType="textPassword"
                        android:paddingStart="20dp"
                        android:paddingEnd="56dp"
                        android:textSize="15sp" />
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="18dp"
                        android:src="@android:drawable/ic_menu_view"
                        app:tint="#94A3B8" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Confirmar contraseña"
                    android:textColor="#475569"
                    android:textStyle="bold"
                    android:textSize="15sp" />
                <EditText
                    android:id="@+id/edtConfirmarPasswordRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edittext_moderno"
                    android:backgroundTint="@color/white"
                    android:drawableStart="@drawable/baseline_lock_24"
                    android:drawablePadding="14dp"
                    android:hint="........."
                    android:inputType="textPassword"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnCrearCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="32dp"
                    android:backgroundTint="@color/white"
                    android:text="Crear cuenta ->"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimario"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/btnYaTienesCuenta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="28dp"
        android:text="¿Ya tienes cuenta? Inicia sesión"
        android:textColor="@color/colorAdvertencia"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>