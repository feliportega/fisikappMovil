<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#001B6B"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:id="@+id/btnBackPasosLab"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="start"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/outline_arrow_circle_left_24"
                app:tint="#DCFBFF" />

            <ImageView
                android:layout_width="96dp"
                android:layout_height="70dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/vector_main_logo" />

            <TextView
                android:id="@+id/tvTituloPasosLab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Pasos del laboratorio"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtituloPasosLab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Sigue estos pasos para completar tu práctica"
                android:textColor="#B4C6EF"
                android:textSize="14sp"
                android:letterSpacing="0.05" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-20dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvEstadoPasosLab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando pasos..."
            android:textColor="#64748B"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPasosLaboratorio"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btnEnviarLaboratorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:backgroundTint="#001B6B"
            android:padding="14dp"
            android:text="Enviar laboratorio"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEntregaEnviada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#ECFDF5"
            android:padding="14dp"
            android:text="Entrega enviada. Calificación pendiente."
            android:textColor="#15803D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>